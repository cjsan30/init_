# init 서버 배포용 환경변수 템플릿.
# 서버의 infra/deploy 폴더에서 `cp .env.example .env` 후 값을 채운다. .env는 커밋하지 않는다.
# 도메인에서 파생되는 주소(DB/Redis/S3/SQS/프론트 URL 등)는 docker-compose.yml이 계산하므로 여기 넣지 않는다.
#
# 비밀값 만들기 예: openssl rand -hex 32

# ---------- 서버/이미지 ----------
# HTTPS 인증서를 받을 도메인(DNS A 레코드가 이 서버 IP를 가리켜야 한다)
DOMAIN=init.example.com
ACME_EMAIL=you@example.com
# GHCR 이미지 위치. 소유자 이름은 소문자로 쓴다.
IMAGE_REGISTRY=ghcr.io/cjsan30
IMAGE_TAG=latest

# ---------- PostgreSQL ----------
POSTGRES_DB=init
POSTGRES_USER=init
# URL에 그대로 들어가므로 영문/숫자만 쓴다(openssl rand -hex 24).
POSTGRES_PASSWORD=

# ---------- 저장소(SeaweedFS, S3 호환) ----------
AWS_REGION=ap-northeast-2
# 서버 내부 S3/SQS 접근용 키. 외부에 노출되지 않지만 임의의 긴 값으로 바꾼다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=init-assets

# ---------- 인증 ----------
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=14d
AUTH_REFRESH_COOKIE_NAME=refreshToken
AUTH_COOKIE_SAME_SITE=lax
FRONTEND_ALLOWED_ORIGINS=
PUBLIC_APPLICATION_MAGIC_LINK_TTL_SECONDS=604800
PUBLIC_APPLICATION_TOKEN_VERIFY_SECRET=
PUBLIC_APPLICATION_TOKEN_SECRET=
PUBLIC_INTERVIEW_ACCESS_TOKEN_SECRET=
PUBLIC_INTERVIEW_ACCESS_TOKEN_TTL_SECONDS=3600

# Google 로그인(선택). 비우면 이메일 가입만 동작한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- 결제(선택) ----------
TOSS_SECRET_KEY=
TOSS_API_BASE_URL=https://api.tosspayments.com
# 데모용 모의면접 이용권 지급. 공개 서비스로 운영하면 false 권장.
PAYMENT_DEV_PASS_GRANT_ENABLED=true

# ---------- 메일(필수) ----------
# 운영 모드에서는 계정과 TLS가 필수다. 예: Brevo/Resend 무료 SMTP, Gmail 앱 비밀번호.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000

# ---------- AI ----------
# 운영 모드 worker는 mock을 허용하지 않는다(openai 필수).
OPENAI_API_KEY=
AI_PROVIDER_MODE=openai
AI_STT_PROVIDER=openai
AI_INTERVIEWER_REALTIME_PROVIDER=mock
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_STT_LANGUAGE=ko
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_API_BASE_URL=https://api.openai.com
OPENAI_REALTIME_STT_MODEL=gpt-realtime-whisper
OPENAI_REALTIME_STT_DELAY=low
AI_TEXT_INPUT_USD_PER_1M_TOKENS=0.15
AI_TEXT_OUTPUT_USD_PER_1M_TOKENS=0.60
AI_STT_USD_PER_MINUTE=0.003

# ---------- Worker / 업로드 ----------
# worker 컨테이너 수. 1개당 작업을 1개씩 처리하고 메모리를 수백 MB 쓴다.
WORKER_REPLICAS=3
# 현재 worker 코드에서 읽지 않는 값이다(동시 처리량은 WORKER_REPLICAS로 조절).
WORKER_CONCURRENCY=2
WORKER_MAX_RETRYABLE_RECEIVES=3
WORKER_VISIBILITY_TIMEOUT_SECONDS=900
WORKER_VISIBILITY_HEARTBEAT_MS=300000
WORKER_BATCH_SIZE=1
WORKER_POLL_INTERVAL_MS=1000
MAX_UPLOAD_BYTES=104857600
JD_IMAGE_MAX_UPLOAD_BYTES=5242880
PUBLIC_APPLICATION_DOCUMENT_MAX_UPLOAD_BYTES=10485760
SIGNED_URL_TTL_SECONDS=900

# ---------- 동시 면접 제한 ----------
# 서버 한 대에서 꼬리질문이 늦지 않게 처리할 수 있는 수준으로 막는다(모의·채용 합산).
MAX_CONCURRENT_INTERVIEWS=5
INTERVIEW_ACTIVE_WINDOW_MINUTES=45

# ---------- 시드 계정 비밀번호(선택) ----------
# 시드를 넣었다면 scripts/reset-seed-passwords.sh 가 이 값으로 공개 기본 비밀번호를 바꾼다.
SEED_ACCOUNT_NEW_PASSWORD=
