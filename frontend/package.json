{
  "name": "final-weapon-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x",
    "npm": ">=10"
  },
  "scripts": {
    "pretest": "npm run test:candidate-profile && npm run test:recruitment-settings-layout",
    "dev": "next dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "audit:avatar-assets": "node ../scripts/audit-interviewer-avatar-assets.mjs",
    "test:candidate-avatar": "tsx src/features/candidate-application-interview/LipSyncTuning.spec.ts && tsx src/features/candidate-application-interview/LipSyncDriver.spec.ts && tsx src/features/candidate-application-interview/realtime-webrtc.spec.ts && tsx src/features/candidate-application-interview/RealtimeLipSyncTuningController.spec.ts && tsx src/features/candidate-application-interview/MouthSpriteRegistration.spec.ts && tsx src/features/candidate-application-interview/LocalInterviewerAvatar.spec.tsx && tsx src/features/candidate-application-interview/LocalInterviewerAvatarCss.spec.ts && tsx src/features/candidate-application-interview/InterviewerRiggingPreview.spec.tsx && node ../scripts/audit-interviewer-avatar-assets.spec.mjs",
    "test:recruitment-settings-layout": "tsx src/features/company-recruiting/recruitment-settings-layout-css.spec.ts",
    "test": "npm run typecheck && npm run test:large-applicant-list && npm run test:applicant-evaluation-polling && npm run test:candidate-job-sort && npm run test:candidate-mock-delete && npm run test:candidate-demo-tools && npm run test:candidate-mock-media && npm run test:interview-media-upload && npm run test:candidate-nonverbal && npm run test:route-policy && npm run test:signup-payload && npm run test:ai-job-polling && npm run test:criteria-settings-sync && npm run test:ai-performance && npm run test:apply-set-override && npm run test:candidate-contract && npm run test:candidate-screening-result && npm run test:interview-runtime-progression && npm run test:realtime-usage-report && npm run test:posting-draft-keywords && npm run test:posting-draft-summary && npm run test:ncs-feature-flag && npm run test:ncs-evaluation-view && npm run test:ncs-report",
    "test:large-applicant-list": "tsx src/features/company-recruiting/applicant-list.spec.ts",
    "test:applicant-evaluation-polling": "tsx src/features/company-recruiting/applicant-evaluation-polling.spec.ts",
    "test:ncs-report": "tsx src/features/company-recruiting/ncs-report-view-model.spec.ts",
    "test:candidate-job-sort": "tsx src/features/candidate-application-interview/candidate-job-sort.spec.ts",
    "test:candidate-mock-delete": "tsx src/features/candidate-application-interview/candidate-mock-delete.spec.ts",
    "test:candidate-demo-tools": "tsx src/features/candidate-application-interview/candidate-demo-tools.spec.ts && tsx src/features/candidate-application-interview/demo-preset-runtime.spec.ts",
    "test:candidate-mock-media": "tsx src/features/candidate-application-interview/candidate-mock-media.spec.ts",
    "test:interview-media-upload": "tsx src/features/candidate-application-interview/interview-recording-profile.spec.ts && tsx src/features/candidate-application-interview/interview-upload-queue.spec.ts",
    "test:posting-draft-keywords": "tsx src/features/company-recruiting/posting-draft-keywords.spec.ts",
    "test:posting-draft-summary": "tsx src/features/company-recruiting/posting-draft-summary.spec.ts",
    "test:route-policy": "tsc -p src/features/auth/tsconfig.route-policy-spec.json && node .next/tests/auth-route-policy/features/auth/routePolicy.spec.js",
    "test:signup-payload": "tsc -p src/features/auth/tsconfig.spec.json && node .next/tests/auth/signup-payload.spec.js",
    "test:ai-job-polling": "tsc -p src/features/company-interview-criteria/tsconfig.spec.json && node .next/tests/company-interview-criteria/ai-job-polling.spec.js && node .next/tests/company-interview-criteria/question-set-workflow.spec.js",
    "test:criteria-settings-sync": "tsx src/features/company-interview-criteria/interview-settings-sync.spec.ts && tsx src/features/company-interview-criteria/ncs-active-profile-settings.spec.ts",
    "test:ai-performance": "tsc -p src/features/ai-performance/tsconfig.spec.json && node .next/tests/ai-performance/client-next-step.spec.js",
    "test:apply-set-override": "tsc -p src/features/candidate-application-interview/tsconfig.apply-set-spec.json && node .next/tests/candidate-apply-set/features/candidate-application-interview/apply-set-override.spec.js",
    "test:candidate-contract": "tsx src/features/candidate-application-interview/contract.spec.ts",
    "test:candidate-screening-result": "tsx src/features/candidate-application-interview/CandidateScreeningResult.spec.tsx",
    "test:interview-runtime-progression": "tsx src/features/candidate-application-interview/runtime-progression.spec.ts",
    "test:realtime-usage-report": "tsx src/features/candidate-application-interview/realtime-usage-report.spec.ts",
    "test:ncs-feature-flag": "tsc -p src/features/company-interview-criteria/tsconfig.ncs-feature-flag-spec.json && node .next/tests/company-interview-ncs-rollout/ncs-feature-flag.spec.js",
    "test:ncs-evaluation-view": "tsc -p src/features/company-recruiting/tsconfig.ncs-evaluation-spec.json && node .next/tests/company-recruiting-ncs/ncs-evaluation-view.spec.js",
    "test:candidate-profile": "tsc -p src/features/candidate-application-interview/tsconfig.candidate-profile-spec.json && node .next/tests/candidate-profile/features/candidate-application-interview/candidate-profile-form.spec.js",
    "test:candidate-nonverbal": "tsx src/features/candidate-application-interview/nonverbal-analysis.spec.ts",
    "build": "next build"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "@tiptap/extension-color": "^3.27.1",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-text-align": "^3.27.1",
    "@tiptap/extension-text-style": "^3.27.1",
    "@tiptap/extension-underline": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "ag-psd": "^31.0.2",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  }
}
