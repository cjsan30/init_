generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  ADMIN
  COMPANY
  CANDIDATE
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DEACTIVATED
}

enum PostingStatus {
  DRAFT
  OPEN
  CLOSING_SOON
  CLOSED
  ARCHIVED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  INTERVIEW_WAITING
  INTERVIEW_DONE
  COMPLETED
  CANCELED
}

enum DocumentStatus {
  NOT_SUBMITTED
  SUBMITTED
  EXTRACTING
  EXTRACTED
  FAILED
}

enum InterviewStatus {
  NOT_READY
  READY
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum ReportStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
}

enum ScreeningDecision {
  UNDECIDED
  PASS
  HOLD
  FAIL
  RETRY
}

enum ScreeningDecisionReasonCode {
  PASS_TOTAL_AND_CRITERIA_MET
  HOLD_TOTAL_BAND
  HOLD_CRITERION_BELOW_PASS_SCORE
  FAIL_BELOW_HOLD_THRESHOLD
  RETRY_REPORT_FAILED
  RETRY_STT_UNAVAILABLE
  RETRY_EVALUATION_INCOMPLETE
  RETRY_SCORE_MISSING
}

enum InterviewType {
  MOCK
  RECRUITING
}

enum InterviewSessionMode {
  STANDARD
  DEMO_PRESET
}

enum QuestionUsageScope {
  STANDARD
  DEMO_PRESET
}

enum ReportType {
  MOCK_INTERVIEW_REPORT
  RECRUITING_REPORT
}

enum DocumentType {
  RESUME
  PORTFOLIO
}

enum ConsentType {
  PRIVACY_COLLECTION
  AI_DOCUMENT_ANALYSIS
  AI_INTERVIEW_RECORDING
}

enum QuestionType {
  INTRO
  TECHNICAL
  EXPERIENCE
  SITUATION
  FOLLOW_UP
  CLOSING
}

enum QuestionOrigin {
  MANUAL
  AI_GENERATED
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum PassMailDeliveryStatus {
  NOT_SENT
  SENT
  FAILED
}

enum AiProcessType {
  DOCUMENT_EXTRACT
  STT
  FOLLOW_UP
  REPORT_GENERATE
  EMBEDDING
  GUARDRAIL_VALIDATE
  CRITERIA_SUGGEST
  QUESTION_GENERATE
  RESUME_QUESTION_GENERATE
  QUESTION_SET_GENERATE
  POSTING_DRAFT_GENERATE
}

enum AiProcessStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum AiRealtimeUsageType {
  STT_RELAY
  INTERVIEWER_VOICE
  INTERVIEWER_PREVIEW
}

enum AiRealtimeUsageSource {
  SERVER_MEASURED
  CLIENT_REPORTED
}

enum AiRetrySource {
  INITIAL
  OPERATOR
}

enum GuardrailResult {
  PASS
  BLOCKED
  REGENERATED
}

enum EmbeddingSourceType {
  POSTING_JD
  CRITERION_TAG
  QUESTION
  APPLICATION_DOCUMENT
  INTERVIEW_ANSWER
  EVALUATION_REPORT
}

enum CandidateEducationLevel {
  HIGH_SCHOOL
  COLLEGE
  UNIVERSITY
  GRADUATE_SCHOOL
  OTHER
}

enum CandidateDegreeType {
  HIGH_SCHOOL_DIPLOMA
  ASSOCIATE
  BACHELOR
  MASTER
  DOCTORATE
  OTHER
}

enum CandidateEducationStatus {
  ENROLLED
  LEAVE_OF_ABSENCE
  GRADUATED
  EXPECTED_GRADUATION
  COMPLETED
  WITHDRAWN
}

enum CandidateActivityType {
  SCHOOL_ACTIVITY
  INTERNSHIP
  CLUB
  PROJECT_TASK
  OVERSEAS_TRAINING
  EDUCATION
}

enum CandidateCredentialType {
  CERTIFICATE
  LANGUAGE_TEST
  AWARD
}

model User {
  userId                    BigInt             @id @default(autoincrement()) @map("user_id")
  email                     String             @unique @db.VarChar(255)
  passwordHash              String?            @map("password_hash") @db.VarChar(255)
  userType                  UserType           @map("user_type")
  name                      String             @db.VarChar(100)
  phone                     String?            @db.VarChar(50)
  status                    UserStatus         @default(PENDING)
  createdAt                 DateTime           @default(now()) @map("created_at")
  updatedAt                 DateTime           @updatedAt @map("updated_at")
  authProvider              AuthProvider       @default(LOCAL) @map("auth_provider")
  providerUserId            String?            @map("provider_user_id") @db.VarChar(255)
  ownedCompany              Company?           @relation("CompanyOwner")
  candidateProfile          CandidateProfile?
  fileAssets                FileAsset[]
  manualEvaluations         ManualEvaluation[]
  notifications             Notification[]
  confirmedScreeningResults Application[]      @relation("ScreeningResultConfirmer")
  paymentCustomers          PaymentCustomer[]
  aiRealtimeUsageLogs       AiRealtimeUsageLog[]

  @@unique([authProvider, providerUserId], map: "uk_users_provider_user")
  @@map("users")
}

model Company {
  companyId                  BigInt                      @id @default(autoincrement()) @map("company_id")
  ownerUserId                BigInt                      @unique @map("owner_user_id")
  name                       String                      @db.VarChar(150)
  businessRegistrationNumber String                      @unique @map("business_registration_number") @db.VarChar(10)
  verificationStatus         String                      @map("verification_status") @db.VarChar(30)
  logoFileId                 BigInt?                     @map("logo_file_id")
  industry                   String?                     @db.VarChar(100)
  profile                    String?
  talentProfile              String?                     @map("talent_profile")
  evaluationPolicy           String?                     @map("evaluation_policy")
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")
  owner                      User                        @relation("CompanyOwner", fields: [ownerUserId], references: [userId])
  logoFile                   FileAsset?                  @relation("CompanyLogo", fields: [logoFileId], references: [fileId])
  postings                   Posting[]
  questions                  Question[]
  paymentCustomers           PaymentCustomer[]
  paymentOrders              PaymentOrder[]
  syntheticApplicantDatasets SyntheticApplicantDataset[]

  @@map("companies")
}

model FileAsset {
  fileId                    BigInt                @id @default(autoincrement()) @map("file_id")
  ownerUserId               BigInt                @map("owner_user_id")
  uploadRequestId           String?               @map("upload_request_id") @db.Uuid
  storageKey                String                @map("storage_key") @db.VarChar(500)
  originalName              String                @map("original_name") @db.VarChar(255)
  mimeType                  String                @map("mime_type") @db.VarChar(100)
  sizeBytes                 BigInt                @map("size_bytes")
  status                    String                @db.VarChar(30)
  createdAt                 DateTime              @default(now()) @map("created_at")
  owner                     User                  @relation(fields: [ownerUserId], references: [userId])
  companyLogos              Company[]             @relation("CompanyLogo")
  candidateProfiles         CandidateProfile[]
  candidateFolders          CandidateFolder[]     @relation("CandidateFolderResume")
  candidateFolderPortfolios CandidateFolder[]     @relation("CandidateFolderPortfolio")
  documents                 ApplicationDocument[]
  videoAnswers              InterviewAnswer[]     @relation("VideoFile")
  audioAnswers              InterviewAnswer[]     @relation("AudioFile")

  @@unique([ownerUserId, uploadRequestId], map: "uq_file_assets_owner_upload_request")
  @@map("file_assets")
}

model CandidateProfile {
  candidateId         BigInt                             @id @default(autoincrement()) @map("candidate_id")
  userId              BigInt                             @unique @map("user_id")
  defaultResumeFileId BigInt?                            @map("default_resume_file_id")
  portfolioUrl        String?                            @map("portfolio_url") @db.VarChar(500)
  githubUrl           String?                            @map("github_url") @db.VarChar(500)
  blogUrl             String?                            @map("blog_url") @db.VarChar(500)
  summary             String?
  coverLetter         String?                            @map("cover_letter")
  createdAt           DateTime                           @default(now()) @map("created_at")
  updatedAt           DateTime                           @updatedAt @map("updated_at")
  user                User                               @relation(fields: [userId], references: [userId])
  defaultResumeFile   FileAsset?                         @relation(fields: [defaultResumeFileId], references: [fileId])
  applications        Application[]
  interviewSessions   InterviewSession[]
  candidateFolders    CandidateFolder[]
  mockPassLedgers     CandidateMockInterviewPassLedger[]
  paymentCustomers    PaymentCustomer[]
  paymentOrders       PaymentOrder[]
  educations          CandidateEducation[]
  careers             CandidateCareer[]
  activities          CandidateActivity[]
  credentials         CandidateCredential[]

  @@map("candidate_profiles")
}

model CandidateEducation {
  educationId    BigInt                   @id @default(autoincrement()) @map("education_id")
  candidateId    BigInt                   @map("candidate_id")
  sortOrder      Int                      @map("sort_order")
  educationLevel CandidateEducationLevel  @map("education_level")
  schoolName     String                   @map("school_name") @db.VarChar(150)
  major          String?                  @db.VarChar(150)
  degreeType     CandidateDegreeType      @map("degree_type")
  status         CandidateEducationStatus
  startMonth     DateTime                 @map("start_month") @db.Date
  endMonth       DateTime?                @map("end_month") @db.Date
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")
  candidate      CandidateProfile         @relation(fields: [candidateId], references: [candidateId], onDelete: Cascade)

  @@unique([candidateId, sortOrder], map: "uk_candidate_educations_order")
  @@map("candidate_educations")
}

model CandidateCareer {
  careerId         BigInt           @id @default(autoincrement()) @map("career_id")
  candidateId      BigInt           @map("candidate_id")
  sortOrder        Int              @map("sort_order")
  companyName      String           @map("company_name") @db.VarChar(150)
  startMonth       DateTime         @map("start_month") @db.Date
  endMonth         DateTime?        @map("end_month") @db.Date
  isCurrent        Boolean          @map("is_current")
  jobRole          String           @map("job_role") @db.VarChar(100)
  department       String?          @db.VarChar(100)
  position         String?          @db.VarChar(100)
  responsibilities String           @db.VarChar(1000)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  candidate        CandidateProfile @relation(fields: [candidateId], references: [candidateId], onDelete: Cascade)

  @@unique([candidateId, sortOrder], map: "uk_candidate_careers_order")
  @@map("candidate_careers")
}

model CandidateActivity {
  activityId       BigInt                @id @default(autoincrement()) @map("activity_id")
  candidateId      BigInt                @map("candidate_id")
  sortOrder        Int                   @map("sort_order")
  activityType     CandidateActivityType @map("activity_type")
  organizationName String                @map("organization_name") @db.VarChar(150)
  startDate        DateTime              @map("start_date") @db.Date
  endDate          DateTime?             @map("end_date") @db.Date
  isOngoing        Boolean               @map("is_ongoing")
  description      String                @db.VarChar(1000)
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  candidate        CandidateProfile      @relation(fields: [candidateId], references: [candidateId], onDelete: Cascade)

  @@unique([candidateId, sortOrder], map: "uk_candidate_activities_order")
  @@map("candidate_activities")
}

model CandidateCredential {
  credentialId   BigInt                  @id @default(autoincrement()) @map("credential_id")
  candidateId    BigInt                  @map("candidate_id")
  sortOrder      Int                     @map("sort_order")
  credentialType CandidateCredentialType @map("credential_type")
  name           String                  @db.VarChar(150)
  issuer         String                  @db.VarChar(150)
  acquiredMonth  DateTime                @map("acquired_month") @db.Date
  result         String?                 @db.VarChar(200)
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  candidate      CandidateProfile        @relation(fields: [candidateId], references: [candidateId], onDelete: Cascade)

  @@unique([candidateId, sortOrder], map: "uk_candidate_credentials_order")
  @@map("candidate_credentials")
}

model CandidateFolder {
  id              BigInt           @id @default(autoincrement())
  candidateId     BigInt           @map("candidate_id")
  name            String           @db.VarChar(100)
  githubUrl       String?          @map("github_url") @db.VarChar(500)
  blogUrl         String?          @map("blog_url") @db.VarChar(500)
  portfolioUrl    String?          @map("portfolio_url") @db.VarChar(500)
  resumeFileId    BigInt?          @map("resume_file_id")
  portfolioFileId BigInt?          @map("portfolio_file_id")
  motivation      String?
  extraNote       String?          @map("extra_note")
  profileSnapshot Json?            @map("profile_snapshot")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  candidate       CandidateProfile @relation(fields: [candidateId], references: [candidateId], onDelete: Cascade)
  resumeFile      FileAsset?       @relation("CandidateFolderResume", fields: [resumeFileId], references: [fileId], onDelete: SetNull)
  portfolioFile   FileAsset?       @relation("CandidateFolderPortfolio", fields: [portfolioFileId], references: [fileId], onDelete: SetNull)

  @@index([candidateId], map: "idx_candidate_folders_candidate_id")
  @@map("candidate_folders")
}

model Posting {
  postingId                  BigInt                             @id @default(autoincrement()) @map("posting_id")
  companyId                  BigInt                             @map("company_id")
  title                      String                             @db.VarChar(200)
  jobRole                    String                             @map("job_role") @db.VarChar(100)
  jobDescription             String?                            @map("job_description")
  careerRequirement          String?                            @map("career_requirement") @db.VarChar(150)
  educationRequirement       String?                            @map("education_requirement") @db.VarChar(150)
  salaryInfo                 String?                            @map("salary_info") @db.VarChar(150)
  workLocation               String?                            @map("work_location") @db.VarChar(150)
  employmentType             String?                            @map("employment_type") @db.VarChar(150)
  // 지원자 필터용 구조화 필드(한글 라벨 코드). 값 검증은 애플리케이션단(IsIn)에서 수행.
  jobRoleCode                String?                            @map("job_role_code") @db.VarChar(50)
  regionCode                 String?                            @map("region_code") @db.VarChar(30)
  careerMinYears             Int?                               @map("career_min_years")
  careerMaxYears             Int?                               @map("career_max_years")
  employmentTypeCode         String?                            @map("employment_type_code") @db.VarChar(20)
  recruitmentType            String?                            @map("recruitment_type") @db.VarChar(20)
  // 회사 위치: 도로명 주소 + 위경도(지원자 공고 상세 지도 핀용). 좌표는 프론트 geocoder 로 채워 저장.
  workplaceAddress           String?                            @map("workplace_address") @db.VarChar(300)
  workplaceLat               Float?                             @map("workplace_lat")
  workplaceLng               Float?                             @map("workplace_lng")
  startsOn                   DateTime?                          @map("starts_on") @db.Date
  endsOn                     DateTime?                          @map("ends_on") @db.Date
  status                     PostingStatus                      @default(DRAFT)
  createdAt                  DateTime                           @default(now()) @map("created_at")
  updatedAt                  DateTime                           @updatedAt @map("updated_at")
  company                    Company                            @relation(fields: [companyId], references: [companyId])
  criteria                   EvaluationCriterion[]
  questions                  Question[]
  applications               Application[]
  questionSets               InterviewQuestionSet[]
  timePolicy                 InterviewTimePolicy?
  questionGenerationPolicy   InterviewQuestionGenerationPolicy?
  autoScreeningPolicy        AutoScreeningPolicy?
  syntheticApplicantDatasets SyntheticApplicantDataset[]

  @@index([companyId, status])
  @@map("postings")
}

model SyntheticApplicantDataset {
  datasetId              String                     @id @map("dataset_id") @db.VarChar(64)
  environment            String                     @db.VarChar(30)
  postingId              BigInt                     @map("posting_id")
  companyId              BigInt                     @map("company_id")
  activeCount            Int                        @map("active_count")
  canceledCount          Int                        @map("canceled_count")
  interactiveCount       Int                        @map("interactive_count")
  pipelineSelectionCount Int                        @default(0) @map("pipeline_selection_count")
  batchSize              Int                        @map("batch_size")
  optionsHash            String                     @map("options_hash") @db.VarChar(64)
  manifestVersion        String                     @default("SYNTHETIC_APPLICANT_MANIFEST_V1") @map("manifest_version") @db.VarChar(40)
  status                 String                     @db.VarChar(30)
  lastError              String?                    @map("last_error")
  createdAt              DateTime                   @default(now()) @map("created_at")
  updatedAt              DateTime                   @updatedAt @map("updated_at")
  appliedAt              DateTime?                  @map("applied_at")
  cleanedAt              DateTime?                  @map("cleaned_at")
  posting                Posting                    @relation(fields: [postingId], references: [postingId], onDelete: Restrict)
  company                Company                    @relation(fields: [companyId], references: [companyId], onDelete: Restrict)
  records                SyntheticApplicantRecord[]

  @@index([postingId, status], map: "idx_synthetic_applicant_datasets_posting_status")
  @@index([companyId, status], map: "idx_synthetic_applicant_datasets_company_status")
  @@map("synthetic_applicant_datasets")
}

model SyntheticApplicantRecord {
  recordId         BigInt                    @id @default(autoincrement()) @map("record_id")
  datasetId        String                    @map("dataset_id") @db.VarChar(64)
  ordinal          Int
  userId           BigInt                    @map("user_id")
  candidateId      BigInt                    @map("candidate_id")
  applicationId    BigInt                    @map("application_id")
  isInteractive    Boolean                   @default(false) @map("is_interactive")
  isCanceled       Boolean                   @default(false) @map("is_canceled")
  lifecycleStage   String                    @map("lifecycle_stage") @db.VarChar(40)
  dataDepth        String                    @map("data_depth") @db.VarChar(40)
  pipelineSelected Boolean                   @default(false) @map("pipeline_selected")
  createdAt        DateTime                  @default(now()) @map("created_at")
  cleanedAt        DateTime?                 @map("cleaned_at")
  dataset          SyntheticApplicantDataset @relation(fields: [datasetId], references: [datasetId], onDelete: Cascade)

  @@unique([datasetId, ordinal], map: "uq_synthetic_applicant_records_dataset_ordinal")
  @@unique([userId], map: "uq_synthetic_applicant_records_user")
  @@unique([candidateId], map: "uq_synthetic_applicant_records_candidate")
  @@unique([applicationId], map: "uq_synthetic_applicant_records_application")
  @@index([datasetId, cleanedAt], map: "idx_synthetic_applicant_records_dataset_cleaned")
  @@map("synthetic_applicant_records")
}

model CriterionTag {
  tagId                  BigInt                @id @default(autoincrement()) @map("tag_id")
  jobRole                String                @map("job_role") @db.VarChar(100)
  name                   String                @db.VarChar(100)
  description            String?
  category               String                @db.VarChar(80)
  isActive               Boolean               @default(true) @map("is_active")
  sortOrder              Int                   @map("sort_order")
  ncsProfileId           String?               @map("ncs_profile_id") @db.VarChar(50)
  defaultNcsQuestionMode String?               @map("default_ncs_question_mode") @db.VarChar(50)
  ncsProfileVersion      String?               @map("ncs_profile_version") @db.VarChar(80)
  criteria               EvaluationCriterion[]

  @@map("criterion_tags")
}

model EvaluationCriterion {
  criterionId            BigInt                          @id @default(autoincrement()) @map("criterion_id")
  postingId              BigInt                          @map("posting_id")
  tagId                  BigInt                          @map("tag_id")
  description            String?
  weight                 Int
  passScore              Int?                            @map("pass_score")
  sortOrder              Int                             @map("sort_order")
  ncsProfileId           String?                         @map("ncs_profile_id") @db.VarChar(50)
  ncsQuestionMode        String?                         @map("ncs_question_mode") @db.VarChar(50)
  ncsProfileVersion      String?                         @map("ncs_profile_version") @db.VarChar(80)
  posting                Posting                         @relation(fields: [postingId], references: [postingId])
  tag                    CriterionTag                    @relation(fields: [tagId], references: [tagId])
  questions              Question[]
  reportScores           ReportScore[]
  questionSetItems       InterviewQuestionSetItem[]
  personalizedQuestions  ApplicationInterviewQuestion[]
  sessionQuestions       InterviewSessionQuestion[]
  ncsAnswerEvaluations   NcsAnswerEvaluation[]
  questionNcsBindings    QuestionNcsBinding[]
  applicationNcsBindings ApplicationQuestionNcsBinding[]
  sessionNcsBindings     SessionQuestionNcsBinding[]
  sessionNcsPolicies     InterviewSessionNcsPolicy[]

  @@map("evaluation_criteria")
}

model AutoScreeningPolicy {
  postingId              BigInt   @id @map("posting_id")
  enabled                Boolean  @default(false)
  passMinTotalScore      Int      @map("pass_min_total_score")
  holdMinTotalScore      Int      @map("hold_min_total_score")
  requireAllCriteriaPass Boolean  @default(true) @map("require_all_criteria_pass")
  policyVersion          Int      @default(1) @map("policy_version")
  decisionPolicyVersion  String   @default("AUTO_SCREENING_DECISION_V1") @map("decision_policy_version") @db.VarChar(80)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  posting                Posting  @relation(fields: [postingId], references: [postingId], onDelete: Cascade)

  @@map("auto_screening_policies")
}

model Question {
  questionId         BigInt                     @id @default(autoincrement()) @map("question_id")
  companyId          BigInt                     @map("company_id")
  postingId          BigInt?                    @map("posting_id")
  criterionId        BigInt?                    @map("criterion_id")
  questionType       QuestionType               @map("question_type")
  content            String
  origin             QuestionOrigin             @default(MANUAL)
  isAiEdited         Boolean                    @default(false) @map("is_ai_edited")
  isActive           Boolean                    @default(true) @map("is_active")
  usageScope         QuestionUsageScope         @default(STANDARD) @map("usage_scope")
  generationSource   String?                    @map("generation_source") @db.VarChar(50)
  ncsProfileId       String?                    @map("ncs_profile_id") @db.VarChar(50)
  ncsQuestionMode    String?                    @map("ncs_question_mode") @db.VarChar(50)
  ncsProfileVersion  String?                    @map("ncs_profile_version") @db.VarChar(80)
  alignmentStatus    String?                    @map("alignment_status") @db.VarChar(40)
  alignmentScore     Decimal?                   @map("alignment_score") @db.Decimal(8, 6)
  alignmentReason    String?                    @map("alignment_reason")
  evaluatorVersion   String?                    @map("evaluator_version") @db.VarChar(80)
  sourceProcessLogId BigInt?                    @map("source_process_log_id")
  company            Company                    @relation(fields: [companyId], references: [companyId])
  posting            Posting?                   @relation(fields: [postingId], references: [postingId])
  criterion          EvaluationCriterion?       @relation(fields: [criterionId], references: [criterionId])
  sourceProcessLog   AiProcessLog?              @relation(fields: [sourceProcessLogId], references: [processLogId], onDelete: SetNull)
  answers            InterviewAnswer[]
  questionSetItems   InterviewQuestionSetItem[]
  sessionQuestions   InterviewSessionQuestion[]
  ncsBindings        QuestionNcsBinding[]

  @@index([sourceProcessLogId], map: "idx_question_bank_source_process_log")
  @@index([postingId, usageScope, isActive], map: "idx_question_bank_posting_usage_active")
  @@map("question_bank")
}

model InterviewQuestionSet {
  questionSetId         BigInt                     @id @default(autoincrement()) @map("question_set_id")
  postingId             BigInt                     @map("posting_id")
  title                 String                     @db.VarChar(200)
  status                String                     @default("DRAFT") @db.VarChar(30)
  createdByProcessLogId BigInt?                    @map("created_by_process_log_id")
  createdAt             DateTime                   @default(now()) @map("created_at")
  updatedAt             DateTime                   @updatedAt @map("updated_at")
  posting               Posting                    @relation(fields: [postingId], references: [postingId])
  createdByProcessLog   AiProcessLog?              @relation(fields: [createdByProcessLogId], references: [processLogId])
  items                 InterviewQuestionSetItem[]

  @@index([postingId, status], map: "idx_interview_question_sets_posting_status")
  @@map("interview_question_sets")
}

model InterviewQuestionSetItem {
  questionSetItemId BigInt               @id @default(autoincrement()) @map("question_set_item_id")
  questionSetId     BigInt               @map("question_set_id")
  questionId        BigInt               @map("question_id")
  criterionId       BigInt?              @map("criterion_id")
  sortOrder         Int                  @map("sort_order")
